# Copy this file to .env.test (gitignored, never commit) and fill in the
# real values from the dedicated, isolated test-only Supabase project.
#
# This project is NOT the application's runtime backend and is NOT the
# Team LIPS production project — it is a separate Supabase organization
# used only by the automated test suite (npm run test). See
# docs/migration/SB-MIG-1.2E/11-test-environment-isolation.md.

SUPABASE_TEST_URL=https://your-test-project-ref.supabase.co
SUPABASE_TEST_ANON_KEY=your-test-anon-key

# SUPABASE_TEST_SERVICE_ROLE_KEY is intentionally NOT here — it goes in
# .env.test.local (gitignored via the repo's existing *.local rule) and is
# never committed. See .env.test.local.example for where to get it.
