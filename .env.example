# Copy this file to .env (gitignored, never commit) and fill in the real
# values from the Team LIPS production Supabase project.
# Get these from: Supabase dashboard -> project -> Project Settings -> API Keys.
#
# VITE_-prefixed variables are exposed to client-side code (Vite convention)
# and should mirror the non-VITE_ values above them.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PROJECT_ID=your-project-ref
SUPABASE_PUBLISHABLE_KEY=your-publishable-key

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PROJECT_ID=your-project-ref
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
