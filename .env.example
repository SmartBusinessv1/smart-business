# Copy this file to .env (gitignored, never commit) and fill in the real
# values from the Team LIPS production Supabase project.
# Get these from: Supabase dashboard -> project -> Project Settings -> API Keys.
#
# VITE_-prefixed variables are exposed to client-side code (Vite convention)
# and should mirror the non-VITE_ values above them.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PROJECT_ID=your-project-ref
SUPABASE_PUBLISHABLE_KEY=your-publishable-key

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PROJECT_ID=your-project-ref
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# SB-P-1.11-GC-38R -- AWS Lambda parser server-side integration
# (src/server-functions/parser-lease.ts). Non-secret identifiers only;
# PARSER_WORKLOAD_CERTIFICATE_PEM / PARSER_WORKLOAD_CERTIFICATE_CHAIN_PEM /
# PARSER_WORKLOAD_PRIVATE_KEY_PEM are secret material provisioned only into
# the approved server secret store (Cloudflare Worker secret bindings) out
# of band -- never placed in this file, never committed. Values below are
# filled in only after the GC-38R non-production deployment workflow has
# actually run; see communication/live/report1.154.md for the real values.
PARSER_AWS_REGION=ap-south-1
PARSER_INGRESS_BUCKET=teamlips-sb-np-parser-658980433673-ap-south-1
PARSER_LAMBDA_FUNCTION_URL=https://your-function-url.lambda-url.ap-south-1.on.aws/
PARSER_ROLES_ANYWHERE_TRUST_ANCHOR_ARN=arn:aws:rolesanywhere:ap-south-1:658980433673:trust-anchor/your-trust-anchor-id
PARSER_ROLES_ANYWHERE_PROFILE_ARN=arn:aws:rolesanywhere:ap-south-1:658980433673:profile/your-profile-id
PARSER_ROLES_ANYWHERE_ROLE_ARN=arn:aws:iam::658980433673:role/TeamLIPS-SB-NonProd-Parser-WorkloadRole
PARSER_WORKLOAD_CERTIFICATE_PEM=
PARSER_WORKLOAD_CERTIFICATE_CHAIN_PEM=
PARSER_WORKLOAD_PRIVATE_KEY_PEM=
